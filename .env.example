# Copy to .env and fill in. .env is gitignored — never commit real values.

# Token signing key. Must be at least 32 bytes; the app refuses to start otherwise.
# Generate one:  python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(48)).decode())"
JWT_KEY=replace-me-with-at-least-32-bytes-of-random

# Local SQL Server password. Needs upper, lower, digit and symbol, 8+ chars.
# This is a throwaway dev database, not your Azure one.
SA_PASSWORD=Local_Dev_Password_1
