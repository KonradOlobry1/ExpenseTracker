@page "/"
@inject IAuthService AuthService
@inject NavigationManager Nav

@code {
    // The app's front door. It used to send everyone to the dashboard, which meant a fresh
    // install opened straight into an empty ledger with no account behind it.
    protected override async Task OnInitializedAsync()
        => Nav.NavigateTo(await AuthService.HasStoredSessionAsync() ? "/dashboard" : "/login");
}
