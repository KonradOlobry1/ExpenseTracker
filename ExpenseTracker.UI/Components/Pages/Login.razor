@page "/login"
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ILocalizationService L

<MudText Typo="Typo.h5" Class="mb-4">@L["Login_Title"]</MudText>

<MudPaper Class="pa-4" Elevation="2" Style="max-width:440px">
    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pt-4">

        @*── Sign In ──*@
        <MudTabPanel Text="@L["Login_SignIn"]">
            @if (!string.IsNullOrEmpty(_signInError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_signInError</MudAlert>
            }
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_signInEmail"
                              Label="@L["Login_Email"]"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email" />
                <MudTextField @bind-Value="_signInPassword"
                              Label="@L["Login_Password"]"
                              InputType="@(_showSignInPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showSignInPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showSignInPassword = !_showSignInPassword" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Disabled="_working"
                           OnClick="DoSignIn">
                    @(_working ? "..." : L["Login_SignIn"])
                </MudButton>
            </MudStack>
        </MudTabPanel>

        @*── Register ──*@
        <MudTabPanel Text="@L["Login_Register"]">
            @if (!string.IsNullOrEmpty(_registerError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_registerError</MudAlert>
            }
            @if (!string.IsNullOrEmpty(_registerSuccess))
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">@_registerSuccess</MudAlert>
            }
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_regEmail"
                              Label="@L["Login_Email"]"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email" />
                <MudTextField @bind-Value="_regPassword"
                              Label="@L["Login_Password"]"
                              InputType="@(_showRegPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showRegPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showRegPassword = !_showRegPassword" />
                <MudTextField @bind-Value="_regConfirmPassword"
                              Label="@L["Login_ConfirmPassword"]"
                              InputType="@(_showRegPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showRegPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showRegPassword = !_showRegPassword" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Disabled="_working"
                           OnClick="DoRegister">
                    @(_working ? "..." : L["Login_Register"])
                </MudButton>
            </MudStack>
        </MudTabPanel>

    </MudTabs>
</MudPaper>

@code {
    // The server address is not asked for — it is a fixed constant (AuthService.ApiBaseUrl),
    // not a per-device setting. There is exactly one production server.

    string _signInEmail = "";
    string _signInPassword = "";
    string _signInError = "";
    bool _showSignInPassword;

    string _regEmail = "";
    string _regPassword = "";
    string _regConfirmPassword = "";
    string _registerError = "";
    string _registerSuccess = "";
    bool _showRegPassword;

    bool _working;

    [SupplyParameterFromQuery(Name = "expired")] public bool Expired { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsLoggedInAsync())
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        // Arrived here from a sync attempt on a token that has run out, rather than from a
        // sign-out. Saying so avoids the impression that the account itself is gone.
        if (Expired) _signInError = L["Login_SessionExpired"];
    }

    async Task DoSignIn()
    {
        _signInError = "";
        if (string.IsNullOrWhiteSpace(_signInEmail) || string.IsNullOrWhiteSpace(_signInPassword))
        {
            _signInError = L["Login_InvalidCredentials"];
            return;
        }

        _working = true;
        try
        {
            var result = await AuthService.LoginAsync(_signInEmail.Trim(), _signInPassword);
            if (result.Succeeded)
                Nav.NavigateTo("/dashboard");
            else
                _signInError = Message(result.Failure);
        }
        finally
        {
            _working = false;
        }
    }

    async Task DoRegister()
    {
        _registerError = "";
        _registerSuccess = "";

        if (string.IsNullOrWhiteSpace(_regEmail) || string.IsNullOrWhiteSpace(_regPassword))
        {
            _registerError = L["Login_InvalidCredentials"];
            return;
        }
        if (_regPassword != _regConfirmPassword)
        {
            _registerError = L["Login_ConfirmPassword"];
            return;
        }

        _working = true;
        try
        {
            var result = await AuthService.RegisterAsync(_regEmail.Trim(), _regPassword);
            if (result.Succeeded)
            {
                _registerSuccess = L["Login_RegisterSuccess"];
                await Task.Delay(800);
                Nav.NavigateTo("/dashboard");
            }
            else
            {
                _registerError = Message(result.Failure);
            }
        }
        finally
        {
            _working = false;
        }
    }

    // AccountLocked can't happen on register — only login records failed attempts — but the
    // switch has to be exhaustive, and mapping it to the same message as an unrecognised
    // reason costs nothing.
    string Message(AuthFailureReason? reason) => reason switch
    {
        AuthFailureReason.InvalidCredentials => L["Login_InvalidCredentials"],
        AuthFailureReason.AccountLocked => L["Login_AccountLocked"],
        AuthFailureReason.NetworkError => L["Login_NetworkError"],
        _ => L["Login_ServerError"],
    };
}
