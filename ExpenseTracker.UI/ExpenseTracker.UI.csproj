<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Multi-targeted so each host binds a build compiled against its own framework:
         ExpenseTracker.Api is net9.0 (App Service DOTNETCORE:9.0), the MAUI head is net10.0.
         Building only net9.0 silently breaks .NET 10 APIs — Router.NotFoundPage does not
         exist in Components 9.x, so Razor emitted it as an unmatched string attribute and
         the .NET 10 Router then failed casting String to Type at runtime. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <!-- Keeps component namespaces as ExpenseTracker.Components.* so nothing that
         referenced them (including MainPage.xaml's clr-namespace) has to change. -->
    <RootNamespace>ExpenseTracker</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="7.*" />
  </ItemGroup>

  <!-- Version-matched per target framework. A bare FrameworkReference cannot be used here:
       the MAUI head consuming this has no ASP.NET Core runtime pack for android-x64 or
       maccatalyst-x64, so it fails to restore. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpenseTracker.Domain\ExpenseTracker.Domain.csproj" />
    <ProjectReference Include="..\ExpenseTracker.Application\ExpenseTracker.Application.csproj" />
  </ItemGroup>

</Project>
