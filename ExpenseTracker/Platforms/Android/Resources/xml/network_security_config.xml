<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        HTTPS is required for everything by default. Cleartext is permitted only for
        the local development API, which runs over plain HTTP on the LAN.

        Add your machine's LAN address below when it changes (ipconfig / ip addr).
        Once the API is served over HTTPS, delete the domain-config block entirely.
    -->
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.100.72</domain>
    </domain-config>
</network-security-config>
