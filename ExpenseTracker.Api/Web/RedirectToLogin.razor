@inject NavigationManager Nav

@code {
    // Anonymous visitors land on the statically rendered sign-in page, which is a real HTTP
    // request and can therefore set the auth cookie.
    protected override void OnInitialized()
        => Nav.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: true);
}
