@page "/account/reset-password"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using ExpenseTracker.Api.Data
@using ExpenseTracker.Api.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject ApiDbContext Db
@inject IHttpContextAccessor HttpContextAccessor

@* Where the emailed link lands. Statically rendered like the rest of the account pages. *@

<div class="login-shell @(IsDarkMode ? "dark" : "")">
    <div class="login-card">
        <h1>Choose a new password</h1>

        @if (_done)
        {
            <p class="login-success" role="status">
                Your password has been changed, and any devices that were still signed in have
                been signed out.
            </p>
            <p class="login-note"><a href="/account/login">Sign in</a></p>
        }
        else if (!_tokenUsable)
        {
            @* One message for unknown, already-spent and expired alike — a visitor holding a
               bad link learns nothing about which kind of bad it is. *@
            <p class="login-error" role="alert">
                This link is invalid or has expired. Reset links last one hour and can be used
                once.
            </p>
            <p class="login-note"><a href="/account/forgot-password">Request a new one</a></p>
        }
        else
        {
            @if (_error is not null)
            {
                <p class="login-error" role="alert">@_error</p>
            }

            <EditForm Model="Input" FormName="reset-password" OnValidSubmit="SubmitAsync" method="post">
                <DataAnnotationsValidator />

                @* The token arrives in the query string on the GET and rides the POST in this
                   hidden field, so the form does not depend on the browser preserving the query
                   string across a submit. InputText rather than a raw <input> so it carries the
                   same generated `name` the binder looks for. *@
                <InputText @bind-Value="Input.Token" type="hidden" />

                <label for="password">New password</label>
                <InputText id="password" @bind-Value="Input.NewPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="@(() => Input.NewPassword)" />

                <label for="confirm">Confirm new password</label>
                <InputText id="confirm" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="@(() => Input.ConfirmPassword)" />

                <button type="submit">Change my password</button>
            </EditForm>

            <p class="login-note"><a href="/account/login">Back to sign in</a></p>
        }
    </div>
</div>

@code {
    // Input is referenced directly by that exact name, here and in every @bind-Value above —
    // see the long note in Login.razor about SSR form binding deriving each input's `name`
    // from the bind expression's own text.
#pragma warning disable BL0008
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    [SupplyParameterFromQuery(Name = "token")] private string? TokenFromQuery { get; set; }

    private bool _tokenUsable = true;
    private bool _done;
    private string? _error;

    private bool IsDarkMode =>
        HttpContextAccessor.HttpContext?.Request.Cookies[PrefKeys.Theme] == "dark";

    protected override async Task OnInitializedAsync()
    {
        // On the GET the token is in the query; on the POST it comes back in the hidden field
        // and the query is not consulted.
        if (string.IsNullOrEmpty(Input.Token))
            Input.Token = TokenFromQuery ?? string.Empty;

        // Checked before rendering as well as on submit, so a dead link says so immediately
        // rather than after the visitor has typed a password twice.
        _tokenUsable = !string.IsNullOrEmpty(Input.Token)
                    && await PasswordResets.FindUsableAsync(Db, Input.Token) is not null;
    }

    private async Task SubmitAsync()
    {
        // Re-checked rather than trusted from OnInitializedAsync: the token could have been
        // spent or expired between rendering this form and submitting it.
        var stored = await PasswordResets.FindUsableAsync(Db, Input.Token);
        if (stored is null)
        {
            _tokenUsable = false;
            return;
        }

        var result = await PasswordResets.CompleteAsync(Db, UserManager, stored, Input.NewPassword);

        if (!result.Succeeded)
        {
            // The token is still unspent, so the visitor can simply correct the password —
            // one rejected attempt must not cost them the link.
            _error = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        _done = true;
    }

    private sealed class InputModel
    {
        public string Token { get; set; } = string.Empty;

        [Required] public string NewPassword { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(NewPassword), ErrorMessage = "The two passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
