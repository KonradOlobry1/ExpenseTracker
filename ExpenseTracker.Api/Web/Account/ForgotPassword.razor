@page "/account/forgot-password"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using ExpenseTracker.Api.Data
@using ExpenseTracker.Api.Models
@using ExpenseTracker.Api.Notifications
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject ApiDbContext Db
@inject IPasswordResetSender Sender
@inject IHttpContextAccessor HttpContextAccessor

@* Statically rendered, like the sign-in page beside it and for the same reason: MudTextField
   emits no `name` attribute outside an interactive render mode, so its fields would not post
   at all. InputText does. *@

<div class="login-shell @(IsDarkMode ? "dark" : "")">
    <div class="login-card">
        <h1>Reset your password</h1>

        @if (_submitted)
        {
            @* Deliberately the same message whether or not that address has an account. This
               page takes no credentials and anyone can load it, so confirming which addresses
               are registered would enumerate the user table for free. *@
            <p class="login-note" role="status">
                If an account exists for <strong>@_submittedAddress</strong>, a reset link is on
                its way. The link is good for one hour and can be used once.
            </p>
            <p class="login-note"><a href="/account/login">Back to sign in</a></p>
        }
        else
        {
            <p class="login-note">
                Enter the address you signed up with and we will send you a link to set a new
                password.
            </p>

            <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="SubmitAsync" method="post">
                <DataAnnotationsValidator />

                <label for="email">Email</label>
                <InputText id="email" @bind-Value="Input.Email" type="email" autocomplete="username" />
                <ValidationMessage For="@(() => Input.Email)" />

                <button type="submit">Send the link</button>
            </EditForm>

            <p class="login-note"><a href="/account/login">Back to sign in</a></p>
        }
    </div>
</div>

@code {
    // Input is referenced directly by that exact name here and in every @bind-Value above, and
    // has to stay that way — see the long note in Login.razor. Blazor's SSR form binding builds
    // each input's `name` attribute from the bind expression's own text and matches posted
    // fields back by it, so routing the markup through any other property silently breaks the
    // correlation and every field posts empty.
#pragma warning disable BL0008
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    private bool _submitted;
    private string _submittedAddress = string.Empty;

    private bool IsDarkMode =>
        HttpContextAccessor.HttpContext?.Request.Cookies[PrefKeys.Theme] == "dark";

    private async Task SubmitAsync()
    {
        var email = Input.Email.Trim();
        var user = await UserManager.FindByEmailAsync(email);

        // The branch is invisible from outside: both paths land on the same panel below.
        if (user is not null)
        {
            var token = await PasswordResets.IssueAsync(Db, user.Id);
            await Sender.SendAsync(email, token);
        }

        _submittedAddress = email;
        _submitted = true;
    }

    private sealed class InputModel
    {
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
    }
}
