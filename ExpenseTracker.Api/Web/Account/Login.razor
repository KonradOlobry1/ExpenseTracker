@page "/account/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using ExpenseTracker.Api.Data
@using ExpenseTracker.Api.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject ApiDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ExpenseTracker.Api.Auth.EntraOptions Entra

@* Statically rendered on purpose: signing in writes a Set-Cookie response header, which an
   interactive circuit cannot do — so this is a plain form post, not an @onclick.

   That rules out MudBlazor's inputs. MudTextField renders no `name` attribute outside an
   interactive render mode, so the fields simply would not post. InputText does emit one. *@

@* Reads the theme the app already stores in a cookie, so signing out of a dark session does
   not land on a white page. Server-side because this page is static — there is no circuit to
   ask, and the request carries the cookie anyway. *@
<div class="login-shell @(IsDarkMode ? "dark" : "")">
    <div class="login-card">
        <h1>Expense Tracker</h1>

        @if (_error is not null)
        {
            <p class="login-error" role="alert">@_error</p>
        }

        <EditForm Model="Input" FormName="login" OnValidSubmit="SubmitAsync" method="post">
            <DataAnnotationsValidator />

            <label for="email">Email</label>
            <InputText id="email" @bind-Value="Input.Email" type="email" autocomplete="username" />
            <ValidationMessage For="@(() => Input.Email)" />

            <label for="password">Password</label>
            <InputText id="password" @bind-Value="Input.Password" type="password" autocomplete="current-password" />
            <ValidationMessage For="@(() => Input.Password)" />

            <label class="login-check">
                <InputCheckbox @bind-Value="Input.Register" />
                <span>I need an account</span>
            </label>

            <button type="submit">Continue</button>
        </EditForm>

        @if (Entra.Enabled)
        {
            @* A plain link, not a form post: the challenge is a redirect to Microsoft, and
               nothing here is submitted. Leaving the password form alone also means the SSR
               binding rules in the code block below are untouched. *@
            <p class="login-or">or</p>
            <a class="login-provider" href="@MicrosoftHref">Sign in with Microsoft</a>
        }

        <p class="login-note"><a href="/account/forgot-password">Forgot your password?</a></p>
    </div>
</div>

@code {
    // The EditForm's Model and every @bind-Value below reference Input directly, by that exact
    // name, and it has to stay that way: Blazor's SSR form binding generates each input's
    // `name` HTML attribute from the bind expression's own text (e.g. "Input.Email") and
    // matches posted fields back to whichever property carries [SupplyParameterFromForm] by
    // that same name. Routing the markup through some other property — even a pure
    // pass-through to Input — breaks that correlation: the posted fields no longer match
    // anything, nothing binds, and every submit round-trips to a blank form with "required"
    // errors instead of signing in. That shipped once; this comment is here so it doesn't
    // happen twice.
    //
    // The property initializer below trips BL0008 ("can be overwritten with null during form
    // posts"), which is real but not a reason to make Input nullable: the fields above already
    // dereference it directly by name for the reason just given, and a nullable Input can't be
    // dereferenced there without failing this project's nullable-warnings-as-errors build.
    // Making that the EditForm's Model would need to go through some other, non-null-typed
    // property — which is the exact indirection that breaks binding. The initializer stays,
    // and the one warning it causes is suppressed with the reason on record.
#pragma warning disable BL0008
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
#pragma warning restore BL0008
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    // Set by the Microsoft callback when it could not sign the user in.
    [SupplyParameterFromQuery(Name = "external")] private string? ExternalError { get; set; }

    private string? _error;

    private string MicrosoftHref => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/account/external/microsoft"
        : $"/account/external/microsoft?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    protected override void OnInitialized()
    {
        // Not shown after a failed password post: the query string is only there on the
        // redirect back from the Microsoft callback.
        _error ??= ExternalError switch
        {
            null => null,
            "email_in_use" => "An account with that email already exists. Sign in with its password instead.",
            "locked" => "Too many failed attempts. Try again in a few minutes.",
            "no_email" => "Microsoft did not share an email address for that account.",
            _ => "Could not sign in with Microsoft. Try again.",
        };
    }

    private bool IsDarkMode =>
        HttpContextAccessor.HttpContext?.Request.Cookies[PrefKeys.Theme] == "dark";

    private async Task SubmitAsync()
    {
        if (Input.Register)
        {
            var user = new AppUser { UserName = Input.Email, Email = Input.Email };
            var created = await UserManager.CreateAsync(user, Input.Password);
            if (!created.Succeeded)
            {
                _error = string.Join(" ", created.Errors.Select(e => e.Description));
                return;
            }

            // A new account has no categories, and without one no expense can be created.
            await DefaultCategories.EnsureForUserAsync(Db, user.Id);

            await SignInManager.SignInAsync(user, isPersistent: true);
            WriteSettingsCookies(user);
        }
        else
        {
            var result = await SignInManager.PasswordSignInAsync(
                Input.Email, Input.Password, isPersistent: true, lockoutOnFailure: true);

            if (result.IsLockedOut)
            {
                // Distinct from a wrong password: otherwise a locked-out user keeps retrying
                // a password that is actually correct.
                _error = "Too many failed attempts. Try again in a few minutes.";
                return;
            }

            if (!result.Succeeded)
            {
                _error = "That email and password did not match an account.";
                return;
            }

            var signedIn = await UserManager.FindByEmailAsync(Input.Email);
            if (signedIn is not null) WriteSettingsCookies(signedIn);
        }

        // Only ever redirect to a path on this site — never to a caller-supplied absolute URL.
        var target = !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/')
            ? ReturnUrl
            : "/";

        Nav.NavigateTo(target, forceLoad: true);
    }

    private void WriteSettingsCookies(AppUser user)
    {
        var response = HttpContextAccessor.HttpContext?.Response;
        if (response is not null) SettingsCookies.Write(response, user);
    }

    private sealed class InputModel
    {
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
        [Required] public string Password { get; set; } = string.Empty;
        public bool Register { get; set; }
    }
}
