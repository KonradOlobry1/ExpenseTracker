<Project>

  <!--
    Central package management: one version per package for the whole solution, pinned
    exactly.

    Exact versions rather than wildcards, so a restore at any later date resolves the same
    binaries for a given commit.

    Microsoft.* runtime packages track the shared framework and move together — keep them on
    one version. A runtime package left behind the target framework is not a build error:
    Blazor emits the newer component parameters as plain string attributes and fails when
    they are cast at run time.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core and Entity Framework — must match the shared framework">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="MudBlazor" Version="7.16.0" />
    <PackageVersion Include="Microsoft.UI.Xaml" Version="2.8.7" />
  </ItemGroup>

  <ItemGroup Label="Networking">
    <!-- AddHttpClient itself; not part of the shared framework outside an ASP.NET Core host,
         and the MAUI head is not one. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- AddStandardResilienceHandler — retry, circuit breaker and timeouts in one call, the
         same shape EnableRetryOnFailure gives the EF side. Tracks its own release cadence,
         not the shared framework's, hence the different major version. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup Label="Tooling">
    <!-- Development only: Swagger is registered behind IsDevelopment(). -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    The MAUI packages are versioned by the installed workload through $(MauiVersion), which is
    not defined this early in evaluation. They keep their versions in the head project via
    VersionOverride, which is the supported escape hatch.
  -->

</Project>
